        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no instaló la herramienta auxiliar, así que nada mantiene el límite de carga."
          }
        }
      }
    },
    "macOS did not remove the helper, so it is still installed and running." : {
