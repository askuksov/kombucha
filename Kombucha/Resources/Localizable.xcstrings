    "Running on the battery. Protection resumes when you plug the adapter back in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running on the battery. Protection resumes when you plug the adapter back in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac läuft im Akkubetrieb. Der Schutz wird fortgesetzt, sobald du das Netzteil wieder anschließt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш Mac працює від акумулятора. Захист відновиться, щойно ви знову підключите адаптер."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac fonctionne sur batterie. La protection reprend dès que vous rebranchez l’adaptateur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac funciona con la batería. La protección se reanuda cuando vuelvas a conectar el adaptador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用电池供电。重新连接适配器后将恢复保护。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーで動作中です。アダプタを接続し直すと保護が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리로 작동 중입니다. 어댑터를 다시 연결하면 보호가 재개됩니다."
          }
        }
      }
    },
