          }
        }
      }
    },
    "This Mac published no battery reading." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac published no battery reading."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac liefert keinen Akkuwert."
          }
        }
      }
    },
    "This Mac publishes no SMC service — a virtual machine has no battery to protect." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac publishes no SMC service — a virtual machine has no battery to protect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac stellt keinen SMC-Dienst bereit – eine virtuelle Maschine hat keinen Akku, den man schützen könnte."
          }
        }
      }
    },
    "This Mac or this macOS version has no charge-inhibit key, so charging cannot be held at a threshold." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac or this macOS version has no charge-inhibit key, so charging cannot be held at a threshold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac oder diese macOS-Version hat keinen Schlüssel zum Sperren des Ladens, daher kann das Laden nicht bei einem Grenzwert gehalten werden."
          }
        }
      }
    },
    "Time range" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time range"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitraum"
          }
        }
      }
    },
    "Topping the battery back up to %lld%%, then it will run straight off the adapter again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topping the battery back up to %lld%%, then it will run straight off the adapter again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku wird wieder auf %lld %% aufgefüllt, danach läuft der Mac wieder direkt über das Netzteil."
          }
        }
      }
    },
    "Two apps writing the same charge limit have no arbiter — whichever wrote last wins, and neither can tell you which. Kombucha has let go of the charger and will not touch it while %@ is running. Quit it and the controls come back, with no restart." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two apps writing the same charge limit have no arbiter — whichever wrote last wins, and neither can tell you which. Kombucha has let go of the charger and will not touch it while %@ is running. Quit it and the controls come back, with no restart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Apps, die dasselbe Ladelimit schreiben, haben keine Instanz, die entscheidet – wer zuletzt schreibt, gewinnt, und keine der beiden kann dir sagen, welche das war. Kombucha hat die Ladesteuerung losgelassen und rührt sie nicht an, solange %@ läuft. Beende die App, dann sind die Bedienelemente ohne Neustart wieder da."
          }
        }
      }
    },
