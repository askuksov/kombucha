    "Battery Rest: your Mac runs straight from the adapter and no current flows through the cell." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery Rest: your Mac runs straight from the adapter and no current flows through the cell."
