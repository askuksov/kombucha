    "Battery Rest: your Mac runs straight from the adapter and no current flows through the cell." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery Rest: your Mac runs straight from the adapter and no current flows through the cell."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akku-Ruhe: Dein Mac läuft direkt über das Netzteil, und es fließt kein Strom durch die Zelle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпочинок акумулятора: ваш Mac працює безпосередньо від адаптера, і струм через елемент не тече."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repos de la batterie : votre Mac fonctionne directement sur l’adaptateur et aucun courant ne traverse la cellule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposo de la batería: tu Mac funciona directamente con el adaptador y no pasa corriente por la celda."
          }
        }
      }
    },
