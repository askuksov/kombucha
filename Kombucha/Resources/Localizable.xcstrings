    "One-time full charge. Kombucha goes back to your %lld–%lld%% range at 100%%, or as soon as you unplug." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time full charge. Kombucha goes back to your %1$lld–%2$lld%% range at 100%%, or as soon as you unplug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmalige volle Ladung. Bei 100 %% oder sobald du das Netzteil abziehst, kehrt Kombucha zu deinem Bereich von %1$lld–%2$lld %% zurück."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одноразовий повний заряд. Після досягнення 100 %% або щойно ви відключите адаптер, Kombucha повернеться до вашого діапазону %1$lld–%2$lld %%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge complète ponctuelle. Kombucha revient à votre plage de %1$lld–%2$lld %% à 100 %%, ou dès que vous débranchez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga completa única. Kombucha vuelve a tu rango del %1$lld–%2$lld %% al llegar al 100 %%, o en cuanto desconectes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次充满。电量达到 100%% 或你拔掉电源时，Kombucha 会回到你的 %1$lld–%2$lld%% 范围。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回だけのフル充電です。100%%に達するか電源を外すと、Kombuchaは設定範囲 %1$lld–%2$lld%% に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번만 완전히 충전합니다. 100%%에 도달하거나 전원을 분리하면 Kombucha가 설정한 %1$lld–%2$lld%% 범위로 돌아갑니다."
          }
        }
      }
    },
