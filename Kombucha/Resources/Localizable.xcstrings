    "Kombucha contacts GitHub once a day to look for a new release. Nothing else is sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha contacts GitHub once a day to look for a new release. Nothing else is sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha fragt einmal täglich bei GitHub nach einer neuen Version. Sonst wird nichts gesendet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha раз на день звертається до GitHub, щоб знайти нову версію. Більше нічого не надсилається."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha contacte GitHub une fois par jour pour chercher une nouvelle version. Rien d’autre n’est envoyé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha consulta GitHub una vez al día para buscar una versión nueva. No se envía nada más."
          }
        }
