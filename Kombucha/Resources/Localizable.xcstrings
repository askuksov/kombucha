    },
    "Kombucha did not hear back from the charger. Open the panel again to see where things stand." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombucha did not hear back from the charger. Open the panel again to see where things stand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ladesteuerung hat nicht auf Kombucha geantwortet. Öffne Kombucha erneut in der Menüleiste, um den aktuellen Stand zu sehen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керування зарядкою не відповіло Kombucha. Відкрийте Kombucha у рядку меню ще раз, щоб побачити поточний стан."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chargeur n’a pas répondu à Kombucha. Rouvrez le panneau pour voir où en sont les choses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cargador no respondió a Kombucha. Vuelve a abrir el panel para ver cómo está todo."
          }
        }
      }
    },
