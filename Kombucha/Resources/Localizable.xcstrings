    },
    "When the battery needs attention" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the battery needs attention"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
