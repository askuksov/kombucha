    "Between your Stop and Resume levels the battery rests: your Mac runs straight from the adapter and no current flows through the cell." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Between your Stop and Resume levels the battery rests: your Mac runs straight from the adapter and no current flows through the cell."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen deinen beiden Grenzwerten ruht der Akku: Dein Mac läuft direkt über das Netzteil, und es fließt kein Strom durch die Zelle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Між вашими двома межами акумулятор відпочиває: ваш Mac працює безпосередньо від адаптера, і струм через елемент не тече."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre vos deux seuils, la batterie se repose : votre Mac fonctionne directement sur l’adaptateur et aucun courant ne traverse la cellule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre tus dos límites la batería reposa: tu Mac funciona directamente con el adaptador y no pasa corriente por la celda."
          }
        }
      }
    },
