        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac läuft im Akkubetrieb. Der Schutz wird fortgesetzt, sobald du das Netzteil wieder anschließt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш Mac працює від акумулятора. Захист відновиться, щойно ви знову підключите адаптер."
