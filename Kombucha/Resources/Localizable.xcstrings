    },
    "This Mac published no battery reading." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac published no battery reading."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac liefert keinen Akkuwert."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Mac не надав показників акумулятора."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n’a fourni aucune mesure de batterie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no ha publicado ninguna lectura de la batería."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
